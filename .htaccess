# ============================================================
# 基础安全加固（Apache）
# ============================================================

# 关闭目录列举
Options -Indexes

# 安全响应头
<IfModule mod_headers.c>
    # 防止 MIME 嗅探
    Header set X-Content-Type-Options "nosniff"
    # 防止点击劫持
    Header set X-Frame-Options "SAMEORIGIN"
    # 禁用旧版 IE XSS 过滤器（现代做法：让浏览器不尝试主动过滤）
    Header set X-XSS-Protection "0"
    # HSTS（仅 HTTPS 部署时生效）
    Header set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    # CSP is emitted by includes/ContentSecurityPolicy.php with a fresh response nonce.
    # Do not overwrite or duplicate that PHP header here; script event attributes are denied.
</IfModule>

# 拒绝直接访问敏感文件类型
<FilesMatch "(?i)\.(lock|log|sh|ps1|sql|bak|ini|sample|md|zip|7z|rar|tar|gz|tgz)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 保护主配置文件（纵深防御：万一 PHP 处理器失效也不泄露源码/密钥）
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 隐藏点文件（.git/.env 等）
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================
# 审计修复 H-2（2026-07-01）：阻止直接访问 api/ 下的独立 PHP 文件
# 所有 API 请求必须通过 api/index.php 路由器，防止双入口鉴权风险
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # CLI maintenance entry points are never valid over HTTP.
    RewriteRule ^bin/ - [F,L,NC]

    # Audit/build trees and Composer output are not public app routes.
    # output/ can contain a nested install.php that ignores the root install.lock.
    RewriteRule ^output/ - [F,L,NC]
    RewriteRule ^docs/ - [F,L,NC]
    RewriteRule ^vendor/ - [F,L,NC]
    RewriteRule ^evals/ - [F,L,NC]
    RewriteRule ^logs/ - [F,L,NC]

    # Uploaded author works are private source documents; serve them only through authenticated PHP flows.
    RewriteRule ^storage/author_works/ - [F,L]

    # TLS termination: configure SetEnvIfExpr in the server/vhost, checking
    # CONN_REMOTE_ADDR against your exact proxy IP(s) and X-Forwarded-Proto == https,
    # to set NOVEL_TRUSTED_HTTPS=1. Never copy a client header into this variable.
    # No proxy is trusted by default. SetEnv runs too late for these rewrite rules.
    # Preserve the server's trusted marker across each internal redirect.
    RewriteCond %{ENV:NOVEL_TRUSTED_HTTPS} =1 [OR]
    RewriteCond %{ENV:REDIRECT_NOVEL_TRUSTED_HTTPS} =1
    RewriteRule ^ - [E=NOVEL_TRUSTED_HTTPS:1]

    # M-6：HTTP → HTTPS 强制重定向（可信 TLS 终止代理已经使用外部 HTTPS）
    RewriteCond %{HTTPS} off
    RewriteCond %{ENV:NOVEL_TRUSTED_HTTPS} !=1
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # H-2：阻止直接访问 api/ 子目录下的 PHP 文件（仅允许 api/index.php）
    # 例外：hot_novels_ingest.php（外部 Agent 推送）、daemon_write.php（Cron 定时任务）、
    #       drama_cron.php（漫剧任务队列 Cron 驱动入口，Token 鉴权）
    # RewriteRule 在 .htaccess 中匹配相对当前应用目录的路径，因此同时覆盖
    # 域名根目录和 /some/subdir/ 子目录部署。
    RewriteRule ^api/(?!index\.php$|hot_novels_ingest\.php$|daemon_write\.php$|drama_cron\.php$).+\.php(?:/.*)?$ - [F,L,NC]
</IfModule>

# ============================================================
# 审计修复 L-5（2026-07-01）：添加 Referrer-Policy 安全头
# ============================================================
<IfModule mod_headers.c>
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
