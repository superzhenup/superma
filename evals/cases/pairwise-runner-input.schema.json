{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.eval.pairwise.input.v1",
  "title": "Harness blind pairwise Judge input bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_version",
    "fixture_version",
    "fixture_provenance",
    "seed",
    "rubric",
    "baseline",
    "candidate",
    "judge",
    "limits",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "harness.eval.pairwise.input.v1"
    },
    "suite_version": {
      "$ref": "#/$defs/identifier"
    },
    "fixture_version": {
      "$ref": "#/$defs/identifier"
    },
    "fixture_provenance": {
      "enum": [
        "synthetic",
        "authorized_deidentified"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "text",
        "dimensions"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "enum": [
              "canon_causality",
              "outline_foreshadow",
              "voice_pov",
              "immersion",
              "pacing",
              "freshness",
              "naturalness",
              "read_on_intent"
            ]
          }
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/variant"
    },
    "candidate": {
      "$ref": "#/$defs/variant"
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "system_prompt"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "system_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials_per_case",
        "max_cases",
        "max_case_characters",
        "max_total_characters",
        "max_requests",
        "max_input_tokens_per_request",
        "max_total_input_tokens",
        "max_output_tokens_per_request",
        "max_total_output_tokens"
      ],
      "properties": {
        "trials_per_case": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "max_cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_case_characters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "max_total_characters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000000
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_input_tokens_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "max_total_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000000
        },
        "max_output_tokens_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_total_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "baseline_content",
          "candidate_content"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "category": {
            "$ref": "#/$defs/identifier"
          },
          "baseline_content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000
          },
          "candidate_content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflow_version",
        "model",
        "prompt_manifest_hash",
        "artifact_manifest_hash",
        "p95_latency_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "workflow_version": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "prompt_manifest_hash": {
          "$ref": "#/$defs/hash"
        },
        "artifact_manifest_hash": {
          "$ref": "#/$defs/hash"
        },
        "p95_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    }
  }
}
